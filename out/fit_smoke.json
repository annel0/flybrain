{
  "params": [
    {
      "name": "w_syn",
      "lo": 0.01,
      "hi": 1.0,
      "log": true,
      "note": "published 0.275 (fitted there, against a female connectome); our earlier fit 0.075"
    },
    {
      "name": "inh_gain",
      "lo": 0.5,
      "hi": 16.0,
      "log": true,
      "note": "inhibition relative to excitation per synapse; balanced-network models commonly use 4-8"
    },
    {
      "name": "tau_syn",
      "lo": 1.0,
      "hi": 15.0,
      "log": false,
      "note": "published 5 ms; ionotropic GABA and GABA-B differ by 10-100x, which one constant cannot represent"
    },
    {
      "name": "v_th",
      "lo": 4.0,
      "hi": 12.0,
      "log": false,
      "note": "published threshold sits 7 mV above rest"
    },
    {
      "name": "sigma",
      "lo": 0.0,
      "hi": 0.4,
      "log": false,
      "note": "background noise. Ours, not the published model's, which has none -- so it is fitted rather than assumed"
    },
    {
      "name": "tau_mem",
      "lo": 10.0,
      "hi": 40.0,
      "log": false,
      "note": "published 20 ms, applied to every cell"
    },
    {
      "name": "tau_mem_kc",
      "lo": 150.0,
      "hi": 500.0,
      "log": false,
      "note": "Kenyon cells are measured at >200 ms, a lower bound. Searched below it too, so the fit can disagree with the measurement visibly rather than silently"
    }
  ],
  "targets": [
    {
      "id": "T-MB-13",
      "obs": "kc_recruited_pct",
      "value": 6.0,
      "tol": 5.0,
      "split": "fit",
      "note": "6 +- 5% of KCs respond to an odour, n=71, electrophysiology, 3.5 SD threshold. T-MB-17 says explicitly: loose tolerance."
    },
    {
      "id": "T-MB-01/02",
      "obs": "apl_block_delta_pp",
      "at_least": 20.0,
      "tol": 10.0,
      "split": "fit",
      "note": "blocking APL raises KC odour response and reduces sparseness. A direction, which a global rescaling cannot produce."
    },
    {
      "id": "T-MB-09",
      "obs": "apl_rate_hz",
      "at_most": 5.0,
      "tol": 5.0,
      "split": "fit",
      "note": "APL does not fire action potentials. Our spiking APL should at least not run hot; a graded APL would satisfy this exactly."
    },
    {
      "id": "T-WB-3",
      "obs": "kc_baseline_hz",
      "at_most": 0.5,
      "tol": 0.5,
      "split": "fit",
      "note": "Kenyon cells are close to silent at baseline, by circuit design."
    },
    {
      "id": "T-AL-16",
      "obs": "pn_peak_hz",
      "value": 160.0,
      "tol": 60.0,
      "split": "fit",
      "note": "Rmax fitted per glomerulus: 170, 167, 163, 144 spikes/s. Tolerance spans the spread plus room for our different drive."
    },
    {
      "id": "T-AL-19",
      "obs": "ln_rate_hz",
      "at_most": 60.0,
      "tol": 40.0,
      "split": "holdout",
      "note": "a substantial population of antennal lobe local interneurons does not spike at all; the fraction is not quantified. Held out because our 227 Hz is so far off that fitting to it would dominate everything else."
    },
    {
      "id": "T-WB-2",
      "obs": "pn_gap_in_sd",
      "at_most": 3.0,
      "tol": 2.0,
      "split": "holdout",
      "note": "projection neurons rest close to spike threshold. No published number exists in fluctuation widths, so this encodes 'close' loosely and is held out rather than fitted."
    },
    {
      "id": "T-WB-1",
      "obs": "silent_fraction_pct",
      "at_most": 60.0,
      "tol": 20.0,
      "split": "holdout",
      "note": "no brain-wide rate distribution has ever been measured, so this is not a measurement -- it encodes only that a brain in which four cells in five never fire is not a plausible resting state."
    },
    {
      "id": "internal",
      "obs": "spontaneous_hz",
      "value": 1.0,
      "tol": 1.5,
      "split": "fit",
      "note": "not from a paper: the order of magnitude implied by the per-cell-type recordings we do have. Marked internal so it is never cited as measured."
    }
  ],
